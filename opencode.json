{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "servers": {
            "github": {
                "type": "local",
                "command": [
                    "github-mcp-server",
                    "stdio"
                ],
                "environment": {
                    "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
                }
            },
            "zai-vision": {
                "type": "local",
                "command": [
                    "node",
                    ".devcontainer/zai-mcp.mjs",
                    "vision"
                ]
            },
            "zai-web-search": {
                "type": "local",
                "command": [
                    "node",
                    ".devcontainer/zai-mcp.mjs",
                    "web-search"
                ]
            },
            "zai-web-reader": {
                "type": "local",
                "command": [
                    "node",
                    ".devcontainer/zai-mcp.mjs",
                    "web-reader"
                ]
            },
            "zai-zread": {
                "type": "local",
                "command": [
                    "node",
                    ".devcontainer/zai-mcp.mjs",
                    "zread"
                ]
            }
        }
    }
}
