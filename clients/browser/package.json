{
  "name": "signal-fish-reference-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Browser reference client for the Signal Fish protocol v3 (real Chromium RTCPeerConnection via playwright-core)",
  "license": "MIT",
  "author": "Ambiguous Interactive <eli@theambiguous.co>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ambiguous-Interactive/signal-fish-server"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prebuild": "npm test",
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc -p tsconfig.page.json && tsc -p tsconfig.cli.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "playwright-core": "1.62.1"
  },
  "devDependencies": {
    "@msgpack/msgpack": "3.1.3",
    "@types/node": "26.4.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
